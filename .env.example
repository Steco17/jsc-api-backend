# Copy this file to .env and replace every placeholder before starting Docker.
# Compose mounts this file read-only and loads only allowlisted application
# settings. Passwords and API keys do not appear in container metadata.
TRANSLATION_MODE=placeholder
# The translation endpoint is public when this is empty. Never put this key in
# a VITE_ variable or other browser code.
TRANSLATION_API_KEY=
# Required to enable POST /contribute. Generate at least 32 random characters.
# Leave empty to disable contribution writes.
CONTRIBUTION_API_KEY=
# API_KEY remains supported only as a legacy fallback for both keys.
API_KEY=

APP_ENV=development
ALLOWED_HOSTS=localhost,127.0.0.1,backend
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ENABLE_API_DOCS=true
EXPOSE_HEALTH_DETAILS=true
MAX_REQUEST_BODY_BYTES=16384
TRANSLATION_RATE_LIMIT=600
CONTRIBUTION_RATE_LIMIT=60
RATE_LIMIT_WINDOW_SECONDS=60
CONTRIBUTION_MAX_FILE_BYTES=52428800
# Names are personal data and are not stored unless explicitly enabled.
STORE_CONTRIBUTOR_NAMES=false

ADMIN_EMAIL=admin@example.org
ADMIN_PASSWORD=replace-this-with-a-strong-password
ADMIN_FIRST_NAME=Admin
ADMIN_LAST_NAME=User
ADMIN_PHONE=
ADMIN_JOB_TITLE=Platform Administrator
ADMIN_ORGANIZATION=JSC Foundation for Learning
